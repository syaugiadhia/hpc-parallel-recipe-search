digraph RecipeResults {
  graph [rankdir=TB, labelloc=t, fontsize=20, fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  label="Little Alchemy Recipe Search";

  subgraph cluster_recipe_1 {
    label="Recipe 1";
    color="#adb5bd";
    n0 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n1 [label="Mud", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n2 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n1 -> n2;
    n3 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n1 -> n3;
    n0 -> n1;
    n4 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n0 -> n4;
  }

}
