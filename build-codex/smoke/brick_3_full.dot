digraph RecipeResults {
  graph [rankdir=TB, labelloc=t, fontsize=20, fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  label="Little Alchemy Recipe Search";

  subgraph cluster_recipe_1 {
    label="Recipe 1";
    color="#adb5bd";
    n0 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n1 [label="Mud\n(truncated)", shape=box, style="rounded,filled", fillcolor="#f8d7da", color="#b02a37"];
    n0 -> n1;
    n2 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n0 -> n2;
  }

  subgraph cluster_recipe_2 {
    label="Recipe 2";
    color="#adb5bd";
    n3 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n4 [label="Clay\n(truncated)", shape=box, style="rounded,filled", fillcolor="#f8d7da", color="#b02a37"];
    n3 -> n4;
    n5 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n3 -> n5;
  }

  subgraph cluster_recipe_3 {
    label="Recipe 3";
    color="#adb5bd";
    n6 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n7 [label="Clay\n(truncated)", shape=box, style="rounded,filled", fillcolor="#f8d7da", color="#b02a37"];
    n6 -> n7;
    n8 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n6 -> n8;
  }

}
