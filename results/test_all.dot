digraph RecipeResults {
  graph [rankdir=TB, labelloc=t, fontsize=20, fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  label="Little Alchemy Recipe Search";

  subgraph cluster_recipe_1 {
    label="Recipe 1";
    color="#adb5bd";
    n0 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n1 [label="Mud", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n2 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n1 -> n2;
    n3 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n1 -> n3;
    n0 -> n1;
    n4 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n0 -> n4;
  }

  subgraph cluster_recipe_2 {
    label="Recipe 2";
    color="#adb5bd";
    n5 [label="Brick", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n6 [label="Clay", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n7 [label="Mud\n(shared, see Recipe 1)", shape=box, style="dashed,filled", fillcolor="#fff3cd", color="#b8860b"];
    n6 -> n7 [style=dashed];
    n8 [label="Stone", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n9 [label="Air", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n8 -> n9;
    n10 [label="Lava", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n11 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n10 -> n11;
    n12 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n10 -> n12;
    n8 -> n10;
    n6 -> n8;
    n5 -> n6;
    n13 [label="Stone\n(shared, see Recipe 2)", shape=box, style="dashed,filled", fillcolor="#fff3cd", color="#b8860b"];
    n5 -> n13 [style=dashed];
  }

}
