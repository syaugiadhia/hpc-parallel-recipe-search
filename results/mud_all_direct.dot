digraph RecipeResults {
  graph [rankdir=TB, labelloc=t, fontsize=20, fontname="Arial"];
  node [fontname="Arial"];
  edge [fontname="Arial"];
  label="Little Alchemy Recipe Search";

  subgraph cluster_recipe_1 {
    label="Recipe 1";
    color="#adb5bd";
    n0 [label="Mud", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n1 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n0 -> n1;
    n2 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n0 -> n2;
  }

  subgraph cluster_recipe_2 {
    label="Recipe 2";
    color="#adb5bd";
    n3 [label="Mud", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n4 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n3 -> n4;
    n5 [label="Soil", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n6 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n5 -> n6;
    n7 [label="Life", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n8 [label="Primordial soup", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n9 [label="Lava", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n10 [label="Earth", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n9 -> n10;
    n11 [label="Fire", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n9 -> n11;
    n8 -> n9;
    n12 [label="Sea", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n13 [label="Lake", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n14 [label="Pond", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n15 [label="Puddle", shape=box, style="rounded,filled", fillcolor="#e7f1ff", color="#084298"];
    n16 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n15 -> n16;
    n17 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n15 -> n17;
    n14 -> n15;
    n18 [label="Puddle\n(shared, see Recipe 2)", shape=box, style="dashed,filled", fillcolor="#fff3cd", color="#b8860b"];
    n14 -> n18 [style=dashed];
    n13 -> n14;
    n19 [label="Water", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n13 -> n19;
    n12 -> n13;
    n20 [label="Lake\n(shared, see Recipe 2)", shape=box, style="dashed,filled", fillcolor="#fff3cd", color="#b8860b"];
    n12 -> n20 [style=dashed];
    n8 -> n12;
    n7 -> n8;
    n21 [label="Time", shape=ellipse, style=filled, fillcolor="#d1e7dd", color="#0f5132"];
    n7 -> n21;
    n5 -> n7;
    n3 -> n5;
  }

}
